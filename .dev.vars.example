# Copy to .dev.vars and fill in. The server loads these via dotenv.
# An LLM provider key is the only hard requirement; individual lessons note
# any extra services they need.
#
# Optional — use a free OpenAI-compatible provider instead of OpenAI:
# OPENAI_BASE_URL   e.g. https://api.groq.com/openai/v1
#                   or   https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL      e.g. llama-3.3-70b-versatile  /  gemini-3.8-flash
#                   (OPENAI_API_KEY is then that provider's key)

OPENAI_API_KEY=sk-...
